# PrimeEstate PostgreSQL
# Gerçek değerleri GitHub'a koyma. Render Environment Variables içinde sakla.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Cloudinary direct browser upload
# Cloudinary Console > Settings > Upload > Upload presets üzerinden
# unsigned bir preset oluşturup bu iki değeri Render Environment Variables'a ekle.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
